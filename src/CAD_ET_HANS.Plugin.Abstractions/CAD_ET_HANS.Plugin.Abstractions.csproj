<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>CAD_ET_HANS.Plugin.Abstractions</RootNamespace>
    <AssemblyName>CAD_ET_HANS.Plugin.Abstractions</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- NuGet 包元数据（发布到 GitHub Packages） -->
    <PackageId>CAD.ET.HANS.Plugin.Abstractions</PackageId>
    <Version>1.0.0</Version>
    <Authors>tticmark</Authors>
    <Company>tticmark</Company>
    <Description>CAD ET HANS 插件 SDK：定义外挂插件需实现的 IPlugin 契约与宿主接口 IPluginHost，供外部插件通过 GitHub Packages 引用后编译为 dll 热加载。</Description>
    <PackageTags>cad;autocad;plugin;express-tools;abstractions</PackageTags>
    <RepositoryUrl>https://github.com/tticmark/CAD_Express_Tools_Hans</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/tticmark/CAD_Express_Tools_Hans</PackageProjectUrl>
  </PropertyGroup>

</Project>
