<Window x:Class="CAD_ET_HANS.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CAD_ET_HANS.App.ViewModels"
        xmlns:conv="clr-namespace:CAD_ET_HANS.App.Converters"
        Title="AutoCAD Express Tools 汉化工具"
        Width="1180" Height="820" MinWidth="960" MinHeight="640"
        Background="{StaticResource AppBgBrush}"
        FontFamily="{StaticResource AppFont}"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrush" />
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Padding="22,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F6CBD" Offset="0" />
                    <GradientStop Color="#115EA3" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="AutoCAD Express Tools 汉化工具" FontSize="20" FontWeight="SemiBold"
                               Foreground="White" />
                    <TextBlock Text="把快捷工具的菜单、功能区、对话框与命令提示汉化为简体中文 · 内置离线词典 · 支持一键还原"
                               FontSize="12" Foreground="#D9E7F7" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#33FFFFFF" CornerRadius="12" Padding="12,5">
                        <TextBlock FontSize="12" Foreground="White">
                            <Run Text="内置词条 " />
                            <Run Text="{Binding DictionaryCount, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=" 条" />
                        </TextBlock>
                    </Border>
                    <Border Background="#33FFFFFF" CornerRadius="12" Padding="12,5" Margin="10,0,0,0">
                        <TextBlock FontSize="12" Foreground="White">
                            <Run Text="AutoCAD " />
                            <Run Text="{Binding Selected.Version, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 环境 + 范围 -->
        <Grid Grid.Row="1" Margin="18,16,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="环境检测" Style="{StaticResource SubHeadingText}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ComboBox Width="150" ItemsSource="{Binding Environments}"
                                      SelectedItem="{Binding Selected}"
                                      DisplayMemberPath="DisplayName" Style="{StaticResource AppCombo}"
                                      Margin="0,0,8,0" />
                            <Button Content="重新检测" Command="{Binding DetectCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" />
                            <Button Content="手动选择" Command="{Binding BrowseCommand}"
                                    Style="{StaticResource SecondaryButton}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Style="{StaticResource BodyText}"
                               Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="安装目录" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InstallPath}"
                                   Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Express 目录" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ExpressPath}"
                                   Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="生效 CUIX" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CuixPath}"
                                   Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="CUIX 源模板" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SourceCuixPath}"
                                   Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="汉化范围与选项" Style="{StaticResource SubHeadingText}" Margin="0,0,0,10" />

                    <CheckBox Content="菜单与功能区（acetmain.cuix）" IsChecked="{Binding LocalizeCuix}"
                              Style="{StaticResource AppCheckBox}" />
                    <TextBlock Text="下拉菜单、功能区面板与按钮、工具栏、命令名与说明" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="22,2,0,8" />

                    <CheckBox Content="对话框（Express\*.dcl）" IsChecked="{Binding LocalizeDcl}"
                              Style="{StaticResource AppCheckBox}" />
                    <TextBlock Text="仅替换 label / text / title 显示文本，控件名与动作保持不变" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="22,2,0,8" />

                    <CheckBox Content="命令提示（Express\*.lsp）" IsChecked="{Binding LocalizeLsp}"
                              Style="{StaticResource AppCheckBox}" />
                    <TextBlock Text="替换 prompt / princ / alert 等界面文本，命令名与 initget 关键字不变" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="22,2,0,8" />

                    <Separator Margin="0,6" />

                    <CheckBox Content="同时汉化 CUIX 源模板（重要）" IsChecked="{Binding LocalizeSourceTemplate}"
                              Style="{StaticResource AppCheckBox}" />
                    <TextBlock Text="AutoCAD 启动会用源模板重建菜单，不改这项重启后菜单会变回英文" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="22,2,0,8" />

                    <CheckBox Content="强制本地化（xlate=false）" IsChecked="{Binding ForceLocalize}"
                              Style="{StaticResource AppCheckBox}" />
                    <TextBlock Text="若汉化后菜单仍显示英文，请保持此项勾选" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="22,2,0,8" />

                    <CheckBox Content="文本使用 UTF-8(BOM) 保存" IsChecked="{Binding Utf8WithBom}"
                              Style="{StaticResource AppCheckBox}" />
                    <TextBlock Text="默认 GB18030，兼容 AutoCAD 读取；乱码时可切换此项" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="22,2,0,8" />

                    <Separator Margin="0,4" />

                    <CheckBox Content="启动后自动扫描（只读，不写入）" IsChecked="{Binding AutoScanOnStartup}"
                              Style="{StaticResource AppCheckBox}" />
                    <TextBlock Text="关闭后程序启动只做环境检测；点「扫描」或「开始汉化」时才读取词条" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="22,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 翻译表 -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="18,14,18,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="翻译表" Style="{StaticResource SubHeadingText}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource BodyText}"
                                   VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Button Content="扫描" Command="{Binding ScanCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                                ToolTip="读取 CUIX / DCL / LSP 中的英文原文并填入译文（只读，不写入）" />
                        <Button Content="导出" Command="{Binding ExportCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" />
                        <Button Content="导入" Command="{Binding ImportCommand}"
                                Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,12,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource AppTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按原文、译文或来源文件搜索" />
                    <ComboBox Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource AppCombo}"
                              SelectedIndex="{Binding StatusFilter}">
                        <ComboBoxItem Content="全部" />
                        <ComboBoxItem Content="待翻译（英文）" />
                        <ComboBoxItem Content="已翻译（待写入）" />
                        <ComboBoxItem Content="已汉化（文件中已是中文）" />
                        <ComboBoxItem Content="已禁用" />
                    </ComboBox>
                </Grid>

                <DataGrid Grid.Row="2" x:Name="EntriesGrid" ItemsSource="{Binding EntriesView}"
                          Style="{StaticResource AppDataGrid}"
                          ColumnHeaderStyle="{StaticResource GridHeader}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Foreground"
                                    Value="{Binding Path=., Converter={StaticResource StatusToBrush}}" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                Width="56" />
                        <DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="84" IsReadOnly="True" />
                        <DataGridTextColumn Header="英文原文" Binding="{Binding Source}" Width="*" MinWidth="260"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="中文译文" Binding="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                                            Width="*" MinWidth="240" />
                        <DataGridTextColumn Header="来源文件" Binding="{Binding OriginFile}" Width="190" IsReadOnly="True" />
                        <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="72" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 底部操作与日志 -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="18,14,18,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="开始汉化" Command="{Binding ApplyCommand}"
                                Style="{StaticResource PrimaryButton}" />
                        <Button Content="一键还原" Command="{Binding RestoreCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" />
                        <Button Content="打开备份目录" Command="{Binding OpenBackupCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource BodyText}" />
                    </StackPanel>
                </Grid>

                <ProgressBar Grid.Row="1" Value="{Binding ProgressValue}" Style="{StaticResource AppProgress}"
                             Margin="0,12,0,10" />

                <TextBox Grid.Row="2" Height="104" Style="{StaticResource LogBox}" Text="{Binding LogText, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Window>
